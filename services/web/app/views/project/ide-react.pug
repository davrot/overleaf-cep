extends ../layout-react

block vars
	- var suppressNavbar = true
	- var suppressFooter = true
	- var suppressSkipToContent = true
	- var deferScripts = true
	- metadata.robotsNoindexNofollow = true
	- enableIeeeBranding = false

block entrypointVar
	- entrypoint = 'pages/ide'

block content
	//- TODO: remove `main` once it's no longer needed by browser extensions
	main#ide-root
		div(class=['loading-screen', `loading-screen-init-${initialLoadingScreenTheme}`])
			.loading-screen-brand-container
				.loading-screen-brand(style='height: 20%')
			h3.loading-screen-label #{translate("loading")}
				span.loading-screen-ellip .
				span.loading-screen-ellip .
				span.loading-screen-ellip .

block append meta
	//- The IDE renders without a viewport meta by default (the controller
	//- passes `metadata: { viewport: false }`); the mobile IDE layout (see the
	//- mobile plan, Phase 0) needs `matchMedia` breakpoints to track the
	//- physical device width and content zoom disabled (the IDE is zoom-free
	//- on mobile), so declare its own viewport meta here.
	meta(name='mobile-web-app-capable' content='yes')
	meta(
		name='viewport'
		content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no'
	)
	include editor/_meta
	
block prepend foot-scripts
	script(
		type='text/javascript'
		nonce=scriptNonce
		src=(wsUrl || '/socket.io') + '/socket.io.js'
		defer=deferScripts
	)

block append head-scripts
	include ./_mixpanel_autocapture.pug
