extends ../../../../app/views/layout-react.pug

block entrypointVar
	- entrypoint = 'pages/user/settings'

block vars
	- isWebsiteRedesign = true

block append meta
	meta(name='ol-mySettingsShell' content='true')
	meta(name='ol-hasPassword' data-type='boolean' content=hasPassword)
	meta(
		name='ol-shouldAllowEditingDetails'
		data-type='boolean'
		content=shouldAllowEditingDetails
	)
	meta(name='ol-oauthProviders' data-type='json' content=oauthProviders)
	meta(name='ol-institutionLinked' data-type='json' content=institutionLinked)
	meta(name='ol-samlError' data-type='json' content=samlError)
	meta(
		name='ol-institutionEmailNonCanonical'
		content=institutionEmailNonCanonical
	)

	meta(name='ol-reconfirmedViaSAML' content=reconfirmedViaSAML)
	meta(name='ol-reconfirmationRemoveEmail' content=reconfirmationRemoveEmail)
	meta(name='ol-samlBeta' content=samlBeta)
	meta(name='ol-ssoErrorMessage' content=ssoErrorMessage)
	meta(name='ol-thirdPartyIds' data-type='json' content=thirdPartyIds || {})
	meta(
		name='ol-passwordStrengthOptions'
		data-type='json'
		content=settings.passwordStrengthOptions || {}
	)
	meta(
		name='ol-isExternalAuthenticationSystemUsed'
		data-type='boolean'
		content=externalAuthenticationSystemUsed()
	)
	meta(name='ol-user' data-type='json' content=user)
	meta(name='ol-showAiFeatures' data-type='boolean' content=showAiFeatures)
	meta(name='ol-labsExperiments' data-type='json' content=labsExperiments)
	meta(name='ol-dropbox' data-type='json' content=dropbox)
	meta(name='ol-github' data-type='json' content=github)
	meta(name='ol-projectSyncSuccessMessage' content=projectSyncSuccessMessage)
	meta(
		name='ol-personalAccessTokens'
		data-type='json'
		content=personalAccessTokens
	)
	meta(name='ol-emailAddressLimit' data-type='number' content=emailAddressLimit)
	meta(
		name='ol-currentManagedUserAdminEmail'
		data-type='string'
		content=currentManagedUserAdminEmail
	)
	meta(name='ol-gitBridgeEnabled' data-type='boolean' content=gitBridgeEnabled)
	meta(name='ol-isSaas' data-type='boolean' content=isSaas)
	meta(
		name='ol-memberOfSSOEnabledGroups'
		data-type='json'
		content=memberOfSSOEnabledGroups
	)
	meta(name='ol-capabilities' data-type='json' content=capabilities)

block content
	// R11 item 1 (2026-08-30): the same CE+ shell as /admin/site — page
	// header + LEFT navigation (anchor links into the single-page settings
	// scroll). The upstream settings React app is unmodified: its sections
	// already expose stable anchors (#update-account-info, #password-change-
	// form, #project-sync, #references, #linked-accounts; Sessions h3 has no
	// id upstream → text-located), and the vanilla nav below only scrolls
	// to them — no upstream file edits.
	.my-settings-shell.user-ds-nav-page.website-redesign
		.my-settings-body
			h1.my-settings-title My settings
			nav.my-settings-left(role='navigation' aria-label='Settings sections')
				ul.my-settings-nav-list.list-unstyled(role='tablist')
					li(role='presentation')
						button.my-settings-nav-btn.active(type='button' data-target='#update-account-info') Update account info
					li(role='presentation')
						button.my-settings-nav-btn(type='button' data-target='#password-change-form') Update password
					li(role='presentation')
						button.my-settings-nav-btn(type='button' data-target='#project-sync') Project synchronisation
					li(role='presentation')
						button.my-settings-nav-btn(type='button' data-target='#references') Reference managers
					li(role='presentation')
						button.my-settings-nav-btn(type='button' data-target='#linked-accounts') Linked accounts
					li(role='presentation')
						button.my-settings-nav-btn(type='button' data-target-text='Sessions') Sessions
			.my-settings-content
			main#main-content.content.content-alt
				#settings-page-root
		script(type='text/javascript', nonce=scriptNonce).
			(function () {
			  function navBtns() {
			    return Array.prototype.slice.call(document.querySelectorAll('.my-settings-nav-btn'))
			  }
			  function targetOf(btn) {
			    var sel = btn.getAttribute('data-target') || ''
			    if (sel) {
			      var el = document.querySelector(sel)
			      if (el) return el
			    }
			    var text = btn.getAttribute('data-target-text')
			    if (text) {
			      var hs = document.querySelectorAll('h3')
			      for (var i = 0; i < hs.length; i += 1) {
			        if ((hs[i].textContent || '').trim() === text) return hs[i]
			      }
			    }
			    return null
			  }
			  function setActive(btn) {
			    navBtns().forEach(function (b) {
			      b.classList.toggle('active', b === btn)
			    })
			  }
			  navBtns().forEach(function (btn) {
			    btn.addEventListener('click', function () {
			      var el = targetOf(btn)
			      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' })
			      setActive(btn)
			    })
			  })
			  // Active-section highlight once the settings app has rendered.
			  function start() {
			    var btns = navBtns()
			    var els = btns.map(targetOf).filter(Boolean)
			    if (!els.length) return false
			    // Hide nav entries whose section is not rendered in this build
			    // (e.g. project sync / reference managers / linked accounts are
			    // SaaS-gated upstream and absent in community editions).
			    navBtns().forEach(function (b) {
			      if (!targetOf(b)) {
			        var li = b.closest('li')
			        if (li) li.style.display = 'none'
			      }
			    })
			    if (!('IntersectionObserver' in window)) return true
			    var map = new Map(els.map(function (el, i) { return [el, btns[i]] }))
			    var io = new IntersectionObserver(function (entries) {
			      var vis = entries
			        .filter(function (e) { return e.isIntersecting })
			        .sort(function (a, b) {
			          return (a.target.compareDocumentPosition(b.target) & 2) ? 1 : -1
			        })
			      var btn = map.get(vis[0].target)
			      if (btn) setActive(btn)
			    }, { rootMargin: '0px 0px -55% 0px', threshold: 0 })
			    els.forEach(function (el) { io.observe(el) })
			    return true
			  }
			  var tries = 0
			  var timer = setInterval(function () {
			    tries += 1
			    if (start() || tries > 40) clearInterval(timer)
			  }, 250)
			})()
